# AI Configuration
# -----------------
# Option 1: Azure Function Proxy (Recommended for production)
# Set the API endpoint for your deployed Azure Function
VITE_API_ENDPOINT=/api

# Option 2: Direct OpenAI API (For local development only)
# WARNING: These keys will be exposed in client-side code!
# Only use for local development, never in production.
# VITE_OPENAI_API_KEY=sk-your-key-here
# VITE_OPENAI_ORG_ID=org-optional

# App Configuration
VITE_APP_NAME=KARABO Discovery
