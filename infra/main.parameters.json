{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "keyVaultName": {
      "value": "${KEY_VAULT_NAME=karabo-keyvault}"
    },
    "allowedOrigin": {
      "value": "${ALLOWED_ORIGIN=*}"
    },
    "embeddingDeployment": {
      "value": "${AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small}"
    },
    "searchEndpoint": {
      "value": "${AZURE_SEARCH_ENDPOINT=https://id8-search.search.windows.net}"
    },
    "searchIndex": {
      "value": "${AZURE_SEARCH_INDEX=karabo-knowledge-v2}"
    }
  }
}
